# docker compose build / push 에 쓰이는 이미지 좌표
KEEPFRAME_IMAGE=westernbear/keepframe
KEEPFRAME_TAG=0.1.0

# 호스트 포트
KEEPFRAME_PORT=8765
KEEPFRAME_ADMIN_PORT=8766

# 워크스페이스 (업로드·프로젝트 저장)
KEEPFRAME_WORKSPACE=./data/workspace

# thread = 오픈소스(같은 프로세스). 클라우드는 keepframe_cloud.runner:QueueRunner 처럼 교체.
KEEPFRAME_JOB_RUNNER=thread
