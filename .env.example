# Image name for docker compose build / push
KEEPFRAME_IMAGE=westernbear/keepframe
KEEPFRAME_TAG=0.1.0

# Host ports
KEEPFRAME_PORT=8765
KEEPFRAME_ADMIN_PORT=8766

# Workspace (uploads and projects)
KEEPFRAME_WORKSPACE=./data/workspace

# thread = OSS (same process). Cloud swaps in keepframe_cloud.runner:QueueRunner.
KEEPFRAME_JOB_RUNNER=thread

# INFO and ERROR go to stdout (`docker logs`). DEBUG is also available.
KEEPFRAME_LOG_LEVEL=INFO

# Admin login (`docker compose --profile admin` or `keepframe serve --admin`).
# Set these explicitly; no default account is provisioned.
# KEEPFRAME_ADMIN_EMAIL=ops@keepframe.app
# KEEPFRAME_ADMIN_PASSWORD=replace-with-secret
# Extra accounts, comma-separated email:password pairs.
# KEEPFRAME_ADMIN_USERS=ops@keepframe.app:replace-with-secret

# GPU overlay (docker-compose.gpu.yml). Needs an NVIDIA GPU and nvidia-container-toolkit.
# Intel iGPU is not used. Overlay sets KEEPFRAME_DEVICE=cuda (no silent CPU fallback).
# TORCH_CUDA=cu124
# NVIDIA_VISIBLE_DEVICES=all
# KEEPFRAME_DEVICE=cuda
